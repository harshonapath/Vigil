# Vigil Backend Environment Variables

APP_NAME="VIGIL Backend"
APP_VERSION="1.0.0"
DEBUG=False

# Database URL (SQL Server / Azure SQL or SQLite)
DATABASE_URL="sqlite:///./vigil.db"

# GitHub App Integration Configuration
GITHUB_APP_ID="5213063"
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_PRIVATE_KEY_PATH=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_API_BASE_URL="https://api.github.com"
REVIEWER_IDENTITY_HMAC_SECRET=""

# CORS Configuration
CORS_ORIGINS=["*"]

# AI Model Configuration (server-side only; Groq OpenAI-compatible endpoint)
AI_PROVIDER="groq"
GROQ_API_KEY=""
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="openai/gpt-oss-120b"
AI_FALLBACK_MODEL="openai/gpt-oss-20b"
AI_TIMEOUT_SECONDS=90.0
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.1
AI_MAX_OUTPUT_TOKENS=6144
SECURITY_ASSUMPTIONS_MAX_ITEMS=30
SECURITY_ASSUMPTIONS_MAX_CONTEXT_CHARS=80000
SECURITY_ASSUMPTIONS_CONFIDENCE_THRESHOLD=0.5
SECURITY_ASSUMPTIONS_EXTRACTION_MODE="changed_code"
SECURITY_ASSUMPTIONS_AMBIGUITY_THRESHOLD=0.15
SECURITY_ASSUMPTIONS_DETERMINISTIC_MATCH_THRESHOLD=1.0
